              {
                "title": "Direction & concepts",
                "description": "Two or three distinct directions, presented with the reasoning behind them.",
                "meta": "Week 3–4"
              },
              {
                "title": "Design & build",
                "description": "We refine the chosen route and build it out with your team, demoing every Friday.",
                "meta": "Week 5–10"
              },
              {
                "title": "Launch & support",
                "description": "Handover, documentation and 30 days of support after go-live.",
                "meta": "Ongoing"
              }
