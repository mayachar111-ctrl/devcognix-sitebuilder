              {
                "question": "Is Ledgerline GST compliant?",
                "answer": "Yes. Invoices include GSTIN, HSN/SAC codes and CGST/SGST/IGST splits, and you can export GSTR-1 ready data."
              },
              {
                "question": "Do you charge a fee on payments?",
                "answer": "Payment-gateway fees are passed through at cost. Ledgerline itself adds nothing on top."
              },
              {
                "question": "Can I import my existing customers?",
                "answer": "Upload a CSV or connect your Tally export — most teams are set up in under 15 minutes."
              },
              {
                "question": "What happens if I cancel?",
                "answer": "You keep read-only access to every invoice and can export all your data anytime."
              }
