            "eyebrow": "FAQ",
            "title": "Common questions",
            "subtitle": "Call or WhatsApp us if you don't see your question here.",
            "items": [
              {
                "question": "Do I need a doctor's referral?",
                "answer": "No. You can book directly. If you have reports or X-rays, please bring them to your first visit."
              },
              {
                "question": "How many sessions will I need?",
                "answer": "It depends on your condition. Most patients feel a difference in 3–4 sessions; we'll give you a clear estimate after the assessment."
              },
              {
                "question": "Is physiotherapy covered by insurance?",
                "answer": "Many health policies cover physiotherapy after hospitalisation. We provide detailed receipts for your claim."
              },
              {
                "question": "What should I wear?",
                "answer": "Loose, comfortable clothing that lets us access the area being treated."
              }
            ]
          }
