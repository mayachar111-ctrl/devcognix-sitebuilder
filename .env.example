# LLM provider: gemini (default) | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Models (defaults shown). Fallbacks are tried on 429 / overload.
GENERATE_MODEL=gemini-3.8-flash
GENERATE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
EDIT_MODEL=gemini-3.5-flash-lite
EDIT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# Anthropic (stub, untested)
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATE_MODEL=claude-sonnet-5-5
ANTHROPIC_EDIT_MODEL=claude-haiku-5-5
# Dev only: cache LLM responses on disk so repeated tests don't use free quota
# LLM_CACHE_DIR=../work/llm-cache
